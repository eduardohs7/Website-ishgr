# Referência de nomes; Django NÃO carrega este arquivo automaticamente.
# Desenvolvimento local usa defaults e autenticação peer no socket privado.
# Para um banco de desenvolvimento próprio, exporte os valores necessários:
# CHAGS_DB_NAME=
# CHAGS_DB_USER=
# CHAGS_DB_PASSWORD=
# CHAGS_DB_HOST=
# CHAGS_DB_PORT=5432

# Produção: fornecer valores pelo ambiente seguro do serviço, nunca no Git.
DJANGO_SETTINGS_MODULE=config.settings.production
CHAGS_SECRET_KEY=
CHAGS_ALLOWED_HOSTS=
CHAGS_DB_NAME=
CHAGS_DB_USER=
CHAGS_DB_PASSWORD=
CHAGS_DB_HOST=
CHAGS_DB_PORT=5432
CHAGS_DB_SSLMODE=verify-full
# Caminho para a CA confiável do banco, quando necessário:
CHAGS_DB_SSLROOTCERT=
# Origens HTTPS adicionais, separadas por vírgula, somente se necessárias:
CHAGS_CSRF_TRUSTED_ORIGINS=
# Ativar apenas após validar a configuração do proxy HTTPS do CTIC:
CHAGS_TRUST_HTTPS_PROXY=false
# Origem canônica da aplicação usada nos e-mails, sem path, query ou fragment:
CHAGS_PUBLIC_URL=
# E-mail de produção: SMTP autenticado ou relay autorizado pela organização.
CHAGS_EMAIL_HOST=
CHAGS_EMAIL_PORT=587
CHAGS_EMAIL_USE_SSL=false
CHAGS_DEFAULT_FROM_EMAIL=
# Deixar ambos vazios somente se o relay permitir envio sem autenticação.
CHAGS_EMAIL_USER=
CHAGS_EMAIL_PASSWORD=
# CIDRs dos proxies que sobrescrevem X-Forwarded-For; vazio não confia no header.
CHAGS_TRUSTED_PROXY_NETWORKS=
